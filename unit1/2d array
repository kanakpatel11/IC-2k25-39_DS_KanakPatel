#include <iostream>
using namespace std;

int main()
{
    int arr[2][3] = {
        {10, 25, 5},
        {40, 15, 30}
    };

    int largest = arr[0][0];

    for(int i = 0; i < 2; i++)
    {
        for(int j = 0; j < 3; j++)
        {
            if(arr[i][j] > largest)
            {
                largest = arr[i][j];
            }
        }
    }

    cout << "Largest element = " << largest;

    return 0;
}
